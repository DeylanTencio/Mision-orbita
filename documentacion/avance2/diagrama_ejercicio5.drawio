<mxfile host="app.diagrams.net"><diagram name="Ejercicio 5" id="d"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1366" pageHeight="2219" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="Ejercicio 5: Selección del destino y autorización del lanzamiento" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="595" height="26" as="geometry"/></mxCell><mxCell id="n1" value="Selecciona el destino con match-case, calcula los recursos de la misión&lt;br&gt;y decide con una condicional anidada si se autoriza el lanzamiento." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="381" height="33" as="geometry"/></mxCell><mxCell id="n2" value="Inicio" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="396" y="119" width="70" height="70" as="geometry"/></mxCell><mxCell id="n3" value="CONSUMO_COMBUSTIBLE_DIA = 8&lt;br&gt;RESERVA_COMBUSTIBLE = 10&lt;br&gt;CONSUMO_OXIGENO_TRIPULANTE_DIA = 2&lt;br&gt;EMERGENCIA_OXIGENO = 5&lt;br&gt;CONSUMO_ENERGIA_DIA = 5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="291" y="219" width="281" height="88" as="geometry"/></mxCell><mxCell id="n4" value="ENERGIA_EXPLORACION = 10&lt;br&gt;CONSUMO_PROVISIONES_TRIPULANTE_DIA = 1&lt;br&gt;PROVISIONES_ADICIONALES = 3&lt;br&gt;DIAS_LUNA = 3&lt;br&gt;DIAS_MARTE = 5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeom