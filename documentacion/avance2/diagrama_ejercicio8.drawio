<mxfile host="app.diagrams.net"><diagram name="Ejercicio 8" id="d"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2236" pageHeight="2396" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=none;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1124" y="796" width="1052" height="461" as="geometry"/></mxCell><mxCell id="n1" value="Ejercicio 8: Evaluación del regreso o supervivencia de la tripulación" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="627" height="26" as="geometry"/></mxCell><mxCell id="n2" value="Si el combustible alcanza, simula el regreso día a día; si no, la tripulación queda&lt;br&gt;varada y se calcula la supervivencia buscando el mínimo sin usar min()." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="426" height="33" as="geometry"/></mxCell><mxCell id="n3" value="Inicio" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="920" y="119" width="70" height="70" as="geometry"/></mxCell><mxCell id="n4" value="CONSUMO_COMBUSTIBLE_DIA = 8&lt;br&gt;CONSUMO_OXIGENO_TRIPULANTE_DIA = 2&lt;br&gt;CONSUMO_ENERGIA_DIA = 5&lt;br&gt;CONSUMO_PROVISIONES_TRIPULANTE_DIA = 1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="802" y="219" width="308" height="74" as="geometry"/></mxCell><mxCell id="n5" value="Leer tripulantes,&lt;br&gt;dias_viaje,&lt;br&gt;combustible,&l