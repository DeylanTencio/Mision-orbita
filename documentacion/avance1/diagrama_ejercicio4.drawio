<mxfile host="app.diagrams.net"><diagram name="Ejercicio 4" id="d"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1061" pageHeight="1146" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Ejercicio 4: Autorización inicial de lanzamiento" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="466" height="26" as="geometry"/></mxCell><mxCell id="ds" value="Autoriza el lanzamiento solo si el combustible alcanza para ida, regreso y reserva,&lt;br&gt;y si el oxígeno, la energía y las provisiones son suficientes." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="437" height="33" as="geometry"/></mxCell><mxCell id="ini" value="Inicio" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="430" y="123" width="80" height="80" as="geometry"/></mxCell><mxCell id="c1" value="RESERVA_COMBUSTIBLE = 10" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="367" y="243" width="206" height="30" as="geometry"/></mxCell><mxCell id="in1" value="Leer combustible_disponible,&lt;br&gt;combustible_ida,&lt;br&gt;combustible_regreso,&lt;br&gt;oxigeno_disponible,&lt;br&gt;oxigeno_requerido" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=20;rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="357" y="314" width="225" height="102" as="geometry"/></mxCell><mxCell